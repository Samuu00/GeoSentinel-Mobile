<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP in chiaro solo verso il backend locale; tutto il resto resta HTTPS -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- il PC visto dall'emulatore -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- per un telefono vero aggiungi qui l'IP del PC sulla rete locale -->
    </domain-config>
</network-security-config>
