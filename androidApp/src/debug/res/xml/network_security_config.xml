<?xml version="1.0" encoding="utf-8"?>
<!-- HTTP in chiaro solo verso il backend locale; tutto il resto resta HTTPS -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- il PC visto dall'emulatore -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- il PC sulla rete locale: MinIO firma gli URL delle foto con MINIO_PUBLIC_ENDPOINT, che punta qui perché
             le foto si vedano anche dall'iPhone. Se l'IP del PC cambia, va cambiato anche qui -->
        <domain includeSubdomains="false">192.168.1.188</domain>
    </domain-config>
</network-security-config>
