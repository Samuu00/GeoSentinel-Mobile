<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. I token cifrati non vanno nel backup né nel trasferimento su un altro telefono: la chiave del
     Keystore non si copia, e lì non si leggerebbero più (M2.1). Il resto dei dati (es. il tema) sì. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="geosentinel.session.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="geosentinel.session.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
