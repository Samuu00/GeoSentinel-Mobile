<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest principale dell'app Android: permessi, classe Application, Activity unica che ospita l'interfaccia
     Compose, servizio delle notifiche push di Firebase e FileProvider per le foto scattate con la fotocamera. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Permesso delle notifiche (richiesto da Android 13 in poi): l'app lo chiede la prima volta che serve, cioè
         all'accesso per un operatore del soccorso e al primo SOS per un escursionista. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Posizione solo con l'app in primo piano (mappa, sentieri vicini, SOS): l'app non chiede la posizione in background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
            android:name=".GeoSentinelApplication"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.GeoSentinel">
        <!-- Servizio delle push di Firebase Cloud Messaging. Con l'app in background la notifica la mostra direttamente FCM,
             usando il canale e l'icona indicati dai meta-data qui sotto. -->
        <service
                android:name=".push.GeoSentinelFirebaseService"
                android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        <meta-data
                android:name="com.google.firebase.messaging.default_notification_channel_id"
                android:value="@string/sos_channel_id"/>
        <meta-data
                android:name="com.google.firebase.messaging.default_notification_icon"
                android:resource="@drawable/ic_notification"/>
        <!-- Activity unica dell'app. Con singleTop il tocco su una notifica ad app aperta arriva in onNewIntent, senza
             creare una seconda istanza sopra. Con configChanges="uiMode" il passaggio tra tema chiaro e scuro lo gestisce
             Compose ridisegnando, senza ricreare l'Activity. -->
        <activity
                android:configChanges="uiMode"
                android:exported="true"
                android:launchMode="singleTop"
                android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- FileProvider per le foto scattate: l'app della fotocamera scrive nella cartella cache/camera tramite un Uri
             temporaneo. Il permesso CAMERA non è dichiarato: dichiararlo obbligherebbe a chiederlo anche per usare l'app
             della fotocamera di sistema. -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.photos"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/photo_paths"/>
        </provider>
    </application>

</manifest>