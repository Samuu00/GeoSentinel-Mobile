TEAM_ID=

PRODUCT_NAME=geosentinel_mobile
PRODUCT_BUNDLE_IDENTIFIER=it.unical.geosentinel-mobile.geosentinel-mobile$(TEAM_ID)

// In un xcconfig "//" apre un commento: $() spezza la doppia barra dell'URL.
// Sul simulatore localhost è il Mac.
API_BASE_URL[config=Debug]=http:/$()/localhost:8080
API_BASE_URL[config=Release]=https:/$()/api.geosentinel.dev

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0